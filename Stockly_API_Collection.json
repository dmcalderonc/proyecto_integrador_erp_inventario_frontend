{
  "info": {
    "name": "Stockly - ERP Inventario API",
    "_postman_id": "stockly-erp-api-collection",
    "description": "Colección completa de endpoints del backend Stockly ERP de Inventario.\n\nBase URL: https://calderon-erp.uaeftt-ute.site\n\nAutenticación: JWT Bearer Token (obtener desde POST /auth/login)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://calderon-erp.uaeftt-ute.site"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"diegoadmin@mail.com\",\n  \"password\": \"admin123\""
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"nuevo_usuario\",\n  \"email\": \"nuevo@mail.com\",\n  \"password\": \"password123\",\n  \"rol\": \"SOLICITANTE\""
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Google OAuth - Iniciar",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth", "google"] }
          }
        },
        {
          "name": "Google OAuth - Callback",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/auth/google/callback", "host": ["{{baseUrl}}"], "path": ["auth", "google", "callback"] }
          }
        },
        {
          "name": "Desvincular Google",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/auth/google", "host": ["{{baseUrl}}"], "path": ["auth", "google"] }
          }
        }
      ]
    },
